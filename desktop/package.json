{
  "name": "relliradio",
  "productName": "RelliRadio",
  "version": "1.0.0",
  "description": "Rell's self-hosted music player for Navidrome",
  "main": "main.js",
  "author": "Rell <prollytrell@users.noreply.github.com>",
  "homepage": "https://github.com/prollytrell/relliradio-android",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "copy-app": "node -e \"require('fs').cpSync('../web/app','app',{recursive:true})\"",
    "start": "npm run copy-app && electron .",
    "dist:linux": "npm run copy-app && electron-builder --linux --publish never",
    "dist:win": "npm run copy-app && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.relli.radio.desktop",
    "productName": "RelliRadio",
    "artifactName": "RelliRadio-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ],
      "category": "AudioVideo;Audio;Player",
      "icon": "build/icon.png",
      "maintainer": "Rell <prollytrell@users.noreply.github.com>",
      "synopsis": "Music player for your Navidrome server"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RelliRadio"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    }
  }
}

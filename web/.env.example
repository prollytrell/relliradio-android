# Copy this file to .env and fill it in:  cp .env.example .env && chmod 600 .env
# .env holds a secret, so never share it, screenshot it, or commit it anywhere.

# The address you'll type into the browser.
RELLI_DOMAIN=radio.prollytrell.duckdns.org

# Your DuckDNS token (top of duckdns.org after signing in). Use a freshly regenerated one.
DUCKDNS_TOKEN=paste-your-token-here

# Where Navidrome listens on your network.
NAVIDROME=192.168.1.10:4533

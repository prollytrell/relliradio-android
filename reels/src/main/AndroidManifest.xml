<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Shared with RelliHome. "signature" = only apps signed with your own key get it. -->
    <permission android:name="com.relli.permission.LINK" android:protectionLevel="signature" />
    <uses-permission android:name="com.relli.permission.LINK" />

    <!-- The same APK installs on phones and on Android TV / Google TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".ReelsApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.RelliReels"
        android:networkSecurityConfig="@xml/network_security_config"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The video player: full screen, landscape, keeps playing through rotation. -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.RelliReels.Player"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:launchMode="singleTop" />

        <!-- RelliHome uses these to open shows and read your sign-in. -->
        <activity
            android:name=".link.LinkActivity"
            android:exported="true"
            android:permission="com.relli.permission.LINK"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.relli.reels.action.PLAY" />
                <action android:name="com.relli.reels.action.LIVE" />
                <action android:name="com.relli.reels.action.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".link.SessionProvider"
            android:authorities="com.relli.reels.session"
            android:exported="true"
            android:readPermission="com.relli.permission.LINK" />
    </application>
</manifest>
